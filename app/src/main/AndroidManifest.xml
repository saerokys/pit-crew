<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Vehicle read permissions (defined by the Vehicle Service, protectionLevel=normal).
        Only the five that the app's read-only calls need (SDK @RequiresPermission of the
        check*Capabilities / getCurrent* calls). No CONTROL_* permission is declared.
        15 other vehicle permissions from the sample app were removed during submission prep (see docs/PROGRESS.md).
    -->
    <!-- Door Position (SC-000 capability, SC-250/300 read). -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <!-- Window Position. -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- EV Battery state of charge. -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Distance Driven (odometer) read only. Vehicle speed and gear are not read. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Turn Signal state. -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />

    <!-- General network permission (not a vehicle permission): reverse geocoding (Nominatim) when the user turns network on in SC-205. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- General permission of the speech service (protectionLevel=normal, not a vehicle permission): TextToSpeech SDK. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- General permission of the speech service (protectionLevel=normal, not a vehicle permission): SpeechToText SDK (voice memo in SC-230). -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- General permission of the navigation service (protectionLevel=normal, not a vehicle permission): NaviHelper SDK requestRoute (SC-280). NAVI_ROUTE is not declared. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- Location read (FusedLocation getLastKnownLocation). protectionLevel=dangerous: asked at runtime in SC-205 only when the user turns location on. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VehicleSampleApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VehicleSampleApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
